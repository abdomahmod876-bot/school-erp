FROM odoo:19.0

USER root

RUN python3 -m pip install --no-cache-dir debugpy \
    || python3 -m pip install --no-cache-dir --break-system-packages debugpy \
    || (apt-get update \
        && apt-get install -y --no-install-recommends python3-pip \
        && python3 -m pip install --no-cache-dir --break-system-packages debugpy \
        && rm -rf /var/lib/apt/lists/*)

USER odoo
