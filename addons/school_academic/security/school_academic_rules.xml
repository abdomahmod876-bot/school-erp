        <record id="rule_academic_year_scoped" model="ir.rule">
            <field name="name">Academic Year: assigned schools only</field>
            <field name="model_id" ref="model_school_academic_year"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_teacher')), (4, ref('school_core.group_school_accountant'))]"/>
            <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
        </record>
