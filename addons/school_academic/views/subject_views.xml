<odoo>
    <data>
        <record id="view_school_subject_list" model="ir.ui.view">
            <field name="name">school.subject.list</field>
            <field name="model">school.subject</field>
            <field name="arch" type="xml">
                <list string="Subjects" decoration-muted="not active">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="subject_type"/>
                    <field name="school_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_school_subject_form" model="ir.ui.view">
            <field name="name">school.subject.form</field>
            <field name="model">school.subject</field>
            <field name="arch" type="xml">
                <form string="Subject">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Mathematics"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="subject_type"/>
                            </group>
                            <group>
                                <field name="school_id" options="{'no_create': True}"/>
                                <field name="branch_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_subject_search" model="ir.ui.view">
            <field name="name">school.subject.search</field>
            <field name="model">school.subject</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <filter name="filter_core" string="Core" domain="[('subject_type', '=', 'core')]"/>
                    <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group name="group_by">
                        <filter name="group_school" string="School" context="{'group_by': 'school_id'}"/>
                        <filter name="group_type" string="Type" context="{'group_by': 'subject_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_school_subject" model="ir.actions.act_window">
            <field name="name">Subjects</field>
            <field name="res_model">school.subject</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
