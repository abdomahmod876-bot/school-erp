<odoo>
    <data>
        <record id="view_school_section_list" model="ir.ui.view">
            <field name="name">school.section.list</field>
            <field name="model">school.section</field>
            <field name="arch" type="xml">
                <list string="Sections" decoration-muted="not active">
                    <field name="name"/>
                    <field name="grade_id"/>
                    <field name="academic_year_id"/>
                    <field name="school_id"/>
                    <field name="capacity"/>
                    <field name="room"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_school_section_form" model="ir.ui.view">
            <field name="name">school.section.form</field>
            <field name="model">school.section</field>
            <field name="arch" type="xml">
                <form string="Section">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label for="name" string="Section Name"/>
                            <h1><field name="name" placeholder="e.g. A"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="grade_id" options="{'no_create': True}"/>
                                <field name="academic_year_id" options="{'no_create': True}"/>
                                <field name="school_id"/>
                            </group>
                            <group>
                                <field name="capacity"/>
                                <field name="room"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes" name="notes">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_section_search" model="ir.ui.view">
            <field name="name">school.section.search</field>
            <field name="model">school.section</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="grade_id"/>
                    <field name="academic_year_id"/>
                    <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group name="group_by">
                        <filter name="group_grade" string="Grade" context="{'group_by': 'grade_id'}"/>
                        <filter name="group_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
                        <filter name="group_school" string="School" context="{'group_by': 'school_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_school_section" model="ir.actions.act_window">
            <field name="name">Sections</field>
            <field name="res_model">school.section</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the first class section</p>
                <p>Sections are the classes inside a grade for a specific academic year.</p>
            </field>
        </record>
    </data>
</odoo>
