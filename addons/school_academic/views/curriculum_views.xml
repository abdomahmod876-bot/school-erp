<odoo>
    <data>
        <record id="view_school_curriculum_list" model="ir.ui.view">
            <field name="name">school.curriculum.list</field>
            <field name="model">school.curriculum</field>
            <field name="arch" type="xml">
                <list string="Curricula" decoration-muted="not active">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="school_id"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_school_curriculum_form" model="ir.ui.view">
            <field name="name">school.curriculum.form</field>
            <field name="model">school.curriculum</field>
            <field name="arch" type="xml">
                <form string="Curriculum">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. National Curriculum"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="school_id" options="{'no_create': True}"/>
                                <field name="branch_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description" name="description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_curriculum_search" model="ir.ui.view">
            <field name="name">school.curriculum.search</field>
            <field name="model">school.curriculum</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group name="group_by">
                        <filter name="group_school" string="School" context="{'group_by': 'school_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_school_curriculum" model="ir.actions.act_window">
            <field name="name">Curricula</field>
            <field name="res_model">school.curriculum</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
