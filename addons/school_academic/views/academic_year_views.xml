<odoo>
    <data>
        <record id="view_school_academic_year_list" model="ir.ui.view">
            <field name="name">school.academic.year.list</field>
            <field name="model">school.academic.year</field>
            <field name="arch" type="xml">
                <list string="Academic Years" decoration-info="is_current" decoration-muted="not active">
                    <field name="name"/>
                    <field name="school_id"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="is_current" widget="boolean_toggle"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_school_academic_year_form" model="ir.ui.view">
            <field name="name">school.academic.year.form</field>
            <field name="model">school.academic.year</field>
            <field name="arch" type="xml">
                <form string="Academic Year">
                    <header>
                        <button name="action_set_current" type="object" string="Set as Current"
                                class="btn-primary" invisible="is_current"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label for="name" string="Academic Year"/>
                            <h1><field name="name" placeholder="e.g. 2026/2027"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="school_id" options="{'no_create': True}"/>
                                <field name="branch_id" options="{'no_create': True}"/>
                                <field name="is_current"/>
                            </group>
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes" name="notes">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_academic_year_search" model="ir.ui.view">
            <field name="name">school.academic.year.search</field>
            <field name="model">school.academic.year</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="school_id"/>
                    <filter name="filter_current" string="Current" domain="[('is_current', '=', True)]"/>
                    <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group name="group_by">
                        <filter name="group_school" string="School" context="{'group_by': 'school_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_school_academic_year" model="ir.actions.act_window">
            <field name="name">Academic Years</field>
            <field name="res_model">school.academic.year</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Create the first academic year</p>
                <p>Only one academic year can be marked as current per school.</p>
            </field>
        </record>
    </data>
</odoo>
