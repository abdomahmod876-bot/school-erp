<odoo>
    <data>
        <record id="rule_school_dashboard_owner_or_shared" model="ir.rule">
            <field name="name">Dashboard: owner or shared groups</field>
            <field name="model_id" ref="model_school_dashboard"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_user')), (4, ref('school_core.group_school_manager'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        </record>
        <record id="rule_school_dashboard_item_owner_or_shared" model="ir.rule">
            <field name="name">Dashboard item: owner or shared groups</field>
            <field name="model_id" ref="model_school_dashboard_item"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_user')), (4, ref('school_core.group_school_manager'))]"/>
            <field name="domain_force">['|', ('dashboard_id.user_id', '=', user.id), ('dashboard_id.group_ids', 'in', user.all_group_ids.ids)]</field>
        </record>
    </data>
</odoo>
