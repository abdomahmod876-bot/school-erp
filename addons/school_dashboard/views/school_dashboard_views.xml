<odoo>
    <data>
        <record id="view_school_dashboard_list" model="ir.ui.view">
            <field name="name">school.dashboard.list</field>
            <field name="model">school.dashboard</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="user_id"/>
                    <field name="item_count"/>
                    <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                    <button name="action_open_dashboard" type="object"
                            string="Open" icon="fa-external-link"/>
                </list>
            </field>
        </record>

        <record id="view_school_dashboard_kanban" model="ir.ui.view">
            <field name="name">school.dashboard.kanban</field>
            <field name="model">school.dashboard</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="name"/>
                    <field name="description"/>
                    <field name="item_count"/>
                    <field name="user_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="o_kanban_card_content">
                                <div class="d-flex justify-content-between align-items-start">
                                    <strong t-esc="record.name.value"/>
                                    <span class="badge text-bg-light">
                                        <t t-esc="record.item_count.value"/> items
                                    </span>
                                </div>
                                <div class="text-muted small mt-1" t-if="record.description.value">
                                    <t t-esc="record.description.value"/>
                                </div>
                                <div class="text-muted small mt-1">
                                    Owner: <t t-esc="record.user_id.value"/>
                                </div>
                                <button type="object" name="action_open_dashboard"
                                        class="btn btn-primary btn-sm mt-2">
                                    Open
                                </button>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_school_dashboard_form" model="ir.ui.view">
            <field name="name">school.dashboard.form</field>
            <field name="model">school.dashboard</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_open_dashboard" type="object"
                                string="Open Dashboard" class="oe_highlight"
                                icon="fa-external-link"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. School Overview"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="user_id"/>
                                <field name="group_ids" widget="many2many_tags"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="sequence"/>
                                <field name="active" invisible="1"/>
                            </group>
                            <group>
                                <field name="description"
                                       placeholder="What does this dashboard track?"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Items" name="items">
                                <field name="item_ids"
                                       context="{'form_view_ref': 'school_dashboard.view_school_dashboard_item_form'}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="item_type"/>
                                        <field name="model_id" options="{'no_create': True}"/>
                                        <field name="measure" optional="show"/>
                                        <field name="measure_field_id" optional="hide" options="{'no_create': True}"/>
                                        <field name="groupby_field_id" optional="show" options="{'no_create': True}"/>
                                        <field name="date_field_id" optional="show" options="{'no_create': True}"/>
                                        <field name="limit" optional="hide"/>
                                        <field name="span"/>
                                        <field name="color" optional="hide"/>
                                        <field name="icon" optional="hide"/>
                                        <field name="domain" optional="hide"/>
                                        <field name="dashboard_id" invisible="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_dashboard_search" model="ir.ui.view">
            <field name="name">school.dashboard.search</field>
            <field name="model">school.dashboard</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="user_id"/>
                    <filter name="my_dashboards" string="My Dashboards"
                            domain="[('user_id', '=', uid)]"/>
                    <group name="group_by">
                        <filter name="group_by_owner" string="Owner"
                                context="{'group_by': 'user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_school_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboards</field>
            <field name="res_model">school.dashboard</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first dashboard
                </p>
                <p>
                    Combine KPI tiles, charts and lists over any Odoo model.
                </p>
            </field>
        </record>
    </data>
</odoo>
