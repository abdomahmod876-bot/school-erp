<odoo>
    <data>
        <record id="view_school_dashboard_item_form" model="ir.ui.view">
            <field name="name">school.dashboard.item.form</field>
            <field name="model">school.dashboard.item</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name" placeholder="e.g. Students by Gender"/></h1>
                        </div>
                        <group>
                            <group string="Data">
                                <field name="item_type"/>
                                <field name="model_id" options="{'no_create': True}"/>
                                <field name="measure"/>
                                <field name="measure_field_id"
                                       options="{'no_create': True}"
                                       invisible="measure == 'count' or not model_id"/>
                                <field name="groupby_field_id"
                                       options="{'no_create': True}"
                                       invisible="item_type in ('tile', 'kpi', 'list') or not model_id"/>
                                <field name="date_field_id"
                                       options="{'no_create': True}"
                                       invisible="not model_id"/>
                                <field name="domain"
                                       placeholder="[('state', '=', 'active')]"
                                       help="Odoo domain. 'uid', 'user', 'today', 'datetime' and 'timedelta' are available."/>
                                <field name="limit"/>
                                <field name="list_field_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       invisible="item_type != 'list' or not model_id"/>
                            </group>
                            <group string="Appearance">
                                <field name="span"/>
                                <field name="color" placeholder="#6366f1"/>
                                <field name="icon" placeholder="fa-users"/>
                                <field name="sequence"/>
                                <field name="dashboard_id" invisible="1"/>
                                <field name="active" invisible="1"/>
                            </group>
                        </group>
                        <div class="text-muted mt-2">
                            Filter examples: <code>[('state', '=', 'active')]</code>,
                            <code>[('user_id', '=', uid)]</code>,
                            <code>[('create_date', '&gt;=', today - timedelta(days=30))]</code>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_dashboard_item_list" model="ir.ui.view">
            <field name="name">school.dashboard.item.list</field>
            <field name="model">school.dashboard.item</field>
            <field name="arch" type="xml">
                <list editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="item_type"/>
                    <field name="model_id" options="{'no_create': True}"/>
                    <field name="measure" optional="show"/>
                    <field name="measure_field_id" optional="hide" options="{'no_create': True}"/>
                    <field name="groupby_field_id" optional="show" options="{'no_create': True}"/>
                    <field name="date_field_id" optional="show" options="{'no_create': True}"/>
                    <field name="limit" optional="hide"/>
                    <field name="span"/>
                    <field name="color" optional="hide"/>
                    <field name="icon" optional="hide"/>
                    <field name="domain" optional="hide"/>
                    <field name="dashboard_id" invisible="1"/>
                </list>
            </field>
        </record>
    </data>
</odoo>
