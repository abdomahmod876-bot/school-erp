<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_school_fee_invoices" model="ir.actions.act_window">
        <field name="name">Student Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('school_fee_assignment_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No student invoices yet</p>
            <p>Invoices are generated from the confirmed student fee plans.</p>
        </field>
    </record>

    <menuitem id="menu_school_fee_invoices"
              name="Student Invoices"
              parent="school_fees.menu_school_fees_root"
              action="action_school_fee_invoices"
              sequence="25"
              groups="account.group_account_invoice"/>
</odoo>
