<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_fee_type_form_accounting" model="ir.ui.view">
        <field name="name">school.fee.type.form.accounting</field>
        <field name="model">school.fee.type</field>
        <field name="inherit_id" ref="school_fees.view_school_fee_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_amount']" position="after">
                <field name="income_account_id" options="{'no_create': True}"
                       groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <record id="view_school_fee_type_list_accounting" model="ir.ui.view">
        <field name="name">school.fee.type.list.accounting</field>
        <field name="model">school.fee.type</field>
        <field name="inherit_id" ref="school_fees.view_school_fee_type_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='default_amount']" position="after">
                <field name="income_account_id" optional="hide"
                       groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
