<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_student_form_accounting" model="ir.ui.view">
        <field name="name">school.student.form.accounting</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="school_student.view_school_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="accounting_partner_id" options="{'no_create': True}"
                       groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>
</odoo>
