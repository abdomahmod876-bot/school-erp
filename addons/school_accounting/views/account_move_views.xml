<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_school_fees" model="ir.ui.view">
        <field name="name">account.move.form.school.fees</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="school_fee_assignment_id" invisible="1"/>
                <button name="action_open_fee_assignment" type="object"
                        string="Fee Plan" icon="fa-graduation-cap"
                        invisible="not school_fee_assignment_id"
                        groups="school_core.group_school_manager,school_core.group_school_accountant"/>
            </xpath>
        </field>
    </record>
</odoo>
