<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_teacher_teacher_school" model="ir.rule">
        <field name="name">Teacher: teachers limited to assigned schools</field>
        <field name="model_id" ref="model_school_teacher"/>
        <field name="groups" eval="[(4, ref('school_core.group_school_teacher'))]"/>
        <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
    </record>

    <record id="rule_teacher_accountant_school" model="ir.rule">
        <field name="name">Teacher: accountants limited to assigned schools</field>
        <field name="model_id" ref="model_school_teacher"/>
        <field name="groups" eval="[(4, ref('school_core.group_school_accountant'))]"/>
        <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
    </record>
</odoo>
