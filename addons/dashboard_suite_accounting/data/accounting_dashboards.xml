<odoo>
    <data noupdate="1">
        <record id="dashboard_accounting_overview" model="dashboard.suite">
            <field name="name">Accounting Overview</field>
            <field name="description">Invoices, bills and journal activity.</field>
            <field name="dashboard_type">predefined</field>
            <field name="visibility">shared</field>
            <field name="sequence">8</field>
        </record>

        <record id="access_accounting_overview_viewers" model="dashboard.suite.access">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="group_id" ref="dashboard_suite_core.group_dashboard_viewer"/>
            <field name="access_level">viewer</field>
        </record>

        <!-- KPI row -->
        <record id="widget_accounting_customer_invoices" model="dashboard.suite.widget">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Customer Invoices</field>
            <field name="widget_type">kpi</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="operation">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_total"/>
            <field name="domain" eval="[['move_type', '=', 'out_invoice'], ['state', '=', 'posted']]"/>
            <field name="width">3</field>
            <field name="height">2</field>
            <field name="sequence">10</field>
        </record>

        <record id="widget_accounting_vendor_bills" model="dashboard.suite.widget">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Vendor Bills</field>
            <field name="widget_type">kpi</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="operation">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_total"/>
            <field name="domain" eval="[['move_type', '=', 'in_invoice'], ['state', '=', 'posted']]"/>
            <field name="width">3</field>
            <field name="height">2</field>
            <field name="sequence">20</field>
        </record>

        <record id="widget_accounting_draft_invoices" model="dashboard.suite.widget">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Draft Invoices</field>
            <field name="widget_type">kpi</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="operation">count</field>
            <field name="domain" eval="[['move_type', 'in', ['out_invoice', 'in_invoice']], ['state', '=', 'draft']]"/>
            <field name="width">3</field>
            <field name="height">2</field>
            <field name="sequence">30</field>
        </record>

        <record id="widget_accounting_posted_entries" model="dashboard.suite.widget">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Posted Entries</field>
            <field name="widget_type">kpi</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="operation">count</field>
            <field name="domain" eval="[['state', '=', 'posted']]"/>
            <field name="width">3</field>
            <field name="height">2</field>
            <field name="sequence">40</field>
        </record>

        <!-- Charts -->
        <record id="widget_accounting_invoices_by_status" model="dashboard.suite.widget">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Invoices by Status</field>
            <field name="widget_type">chart</field>
            <field name="chart_type">bar</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="operation">count</field>
            <field name="group_by_field_id" ref="account.field_account_move__state"/>
            <field name="domain" eval="[['move_type', 'in', ['out_invoice', 'in_invoice']]]"/>
            <field name="width">6</field>
            <field name="height">3</field>
            <field name="sequence">50</field>
        </record>

        <record id="widget_accounting_revenue_trend" model="dashboard.suite.widget">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Revenue Trend</field>
            <field name="widget_type">chart</field>
            <field name="chart_type">line</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="operation">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_untaxed"/>
            <field name="date_field_id" ref="account.field_account_move__invoice_date"/>
            <field name="domain" eval="[['move_type', '=', 'out_invoice'], ['state', '=', 'posted']]"/>
            <field name="config" eval="{'granularity': 'month'}"/>
            <field name="width">6</field>
            <field name="height">3</field>
            <field name="limit">12</field>
            <field name="sequence">60</field>
        </record>

        <record id="widget_accounting_bills_by_vendor" model="dashboard.suite.widget">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Bills by Vendor</field>
            <field name="widget_type">chart</field>
            <field name="chart_type">doughnut</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="operation">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_total"/>
            <field name="group_by_field_id" ref="account.field_account_move__partner_id"/>
            <field name="domain" eval="[['move_type', '=', 'in_invoice'], ['state', '=', 'posted']]"/>
            <field name="width">6</field>
            <field name="height">3</field>
            <field name="sequence">70</field>
        </record>

        <!-- Table -->
        <record id="widget_accounting_recent_invoices" model="dashboard.suite.widget">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Recent Invoices</field>
            <field name="widget_type">table</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="operation">count</field>
            <field name="sort_field_id" ref="account.field_account_move__invoice_date"/>
            <field name="config" eval="{'columns': ['name', 'partner_id', 'invoice_date', 'amount_total', 'state'], 'sort_direction': 'desc'}"/>
            <field name="width">6</field>
            <field name="height">3</field>
            <field name="limit">6</field>
            <field name="sequence">80</field>
        </record>

        <!-- Filters -->
        <record id="filter_accounting_invoice_date_from" model="dashboard.suite.filter">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Invoice Date From</field>
            <field name="filter_type">date</field>
            <field name="field_id" ref="account.field_account_move__invoice_date"/>
            <field name="operator">&gt;=</field>
            <field name="sequence">10</field>
        </record>

        <record id="filter_accounting_partner" model="dashboard.suite.filter">
            <field name="dashboard_id" ref="dashboard_accounting_overview"/>
            <field name="name">Partner</field>
            <field name="filter_type">many2one</field>
            <field name="field_id" ref="account.field_account_move__partner_id"/>
            <field name="operator">=</field>
            <field name="sequence">20</field>
        </record>
    </data>
</odoo>
