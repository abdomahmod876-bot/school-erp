<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_fee_type_list" model="ir.ui.view">
        <field name="name">school.fee.type.list</field>
        <field name="model">school.fee.type</field>
        <field name="arch" type="xml">
            <list string="Fee Types" sample="1">
                <field name="code"/>
                <field name="name"/>
                <field name="category" widget="badge"/>
                <field name="default_amount"/>
                <field name="school_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_school_fee_type_form" model="ir.ui.view">
        <field name="name">school.fee.type.form</field>
        <field name="model">school.fee.type</field>
        <field name="arch" type="xml">
            <form string="Fee Type">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Tuition Fee"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="default_amount"/>
                        </group>
                        <group>
                            <field name="school_id" options="{'no_create': True}"/>
                            <field name="branch_id" options="{'no_create': True}"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Internal description..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_fee_type_search" model="ir.ui.view">
        <field name="name">school.fee.type.search</field>
        <field name="model">school.fee.type</field>
        <field name="arch" type="xml">
            <search string="Fee Types">
                <field name="name"/>
                <field name="code"/>
                <field name="school_id"/>
                <filter name="filter_inactive" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_category" string="Category"
                        context="{'group_by': 'category'}"/>
                <filter name="group_school" string="School"
                        context="{'group_by': 'school_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_fee_type" model="ir.actions.act_window">
        <field name="name">Fee Types</field>
        <field name="res_model">school.fee.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_fee_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first fee type</p>
            <p>Fee types are reused in the fee structures of each grade.</p>
        </field>
    </record>
</odoo>
