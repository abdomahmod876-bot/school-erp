<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_fee_assignment_list" model="ir.ui.view">
        <field name="name">school.fee.assignment.list</field>
        <field name="model">school.fee.assignment</field>
        <field name="arch" type="xml">
            <list string="Student Fees" sample="1">
                <field name="reference"/>
                <field name="student_id"/>
                <field name="academic_year_id"/>
                <field name="structure_id" optional="show"/>
                <field name="total_amount"/>
                <field name="paid_amount"/>
                <field name="balance"/>
                <field name="payment_state" widget="badge"
                       decoration-info="payment_state == 'not_paid'"
                       decoration-warning="payment_state == 'partial'"
                       decoration-success="payment_state == 'paid'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_school_fee_assignment_form" model="ir.ui.view">
        <field name="name">school.fee.assignment.form</field>
        <field name="model">school.fee.assignment</field>
        <field name="arch" type="xml">
            <form string="Fee Plan">
                <header>
                    <button name="action_generate_lines" string="Generate Lines"
                            type="object" invisible="state != 'draft' or not structure_id"/>
                    <button name="action_confirm" string="Confirm"
                            type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_register_payment" string="Register Payment"
                            type="object" class="btn-primary"
                            invisible="state != 'confirmed' or payment_state == 'paid'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object" invisible="state == 'cancelled'"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="student_id" string="Student"/>
                        <h1><field name="student_id" options="{'no_create': True}"/></h1>
                        <group>
                            <field name="reference" readonly="1"/>
                        </group>
                    </div>
                    <group>
                        <group>
                            <field name="school_id" options="{'no_create': True}"/>
                            <field name="branch_id" options="{'no_create': True}"/>
                            <field name="academic_year_id" options="{'no_create': True}"/>
                            <field name="structure_id" options="{'no_create': True}"/>
                            <field name="date"/>
                        </group>
                        <group string="Summary" name="summary">
                            <field name="total_amount"/>
                            <field name="paid_amount"/>
                            <field name="balance"/>
                            <field name="payment_state" widget="badge"
                                   decoration-info="payment_state == 'not_paid'"
                                   decoration-warning="payment_state == 'partial'"
                                   decoration-success="payment_state == 'paid'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fee Lines" name="fee_lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="fee_type_id"
                                           domain="[('school_id', '=', parent.school_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="amount"/>
                                    <field name="due_date"/>
                                    <field name="paid_amount" readonly="1"/>
                                    <field name="balance" readonly="1"/>
                                    <field name="state" widget="badge" readonly="1"
                                           decoration-danger="state == 'unpaid'"
                                           decoration-warning="state == 'partial'"
                                           decoration-success="state == 'paid'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_fee_assignment_search" model="ir.ui.view">
        <field name="name">school.fee.assignment.search</field>
        <field name="model">school.fee.assignment</field>
        <field name="arch" type="xml">
            <search string="Student Fees">
                <field name="reference"/>
                <field name="student_id"/>
                <field name="academic_year_id"/>
                <field name="structure_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter name="filter_not_paid" string="Not Paid"
                        domain="[('payment_state', '=', 'not_paid')]"/>
                <filter name="filter_partial" string="Partially Paid"
                        domain="[('payment_state', '=', 'partial')]"/>
                <filter name="filter_paid" string="Paid"
                        domain="[('payment_state', '=', 'paid')]"/>
                <separator/>
                <filter name="group_year" string="Academic Year"
                        context="{'group_by': 'academic_year_id'}"/>
                <filter name="group_structure" string="Fee Structure"
                        context="{'group_by': 'structure_id'}"/>
                <filter name="group_payment_state" string="Payment Status"
                        context="{'group_by': 'payment_state'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_fee_assignment" model="ir.actions.act_window">
        <field name="name">Student Fees</field>
        <field name="res_model">school.fee.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_school_fee_assignment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No fee plans yet</p>
            <p>Assign a fee structure to the enrolled students, confirm the plan and register the payments.</p>
        </field>
    </record>

    <record id="view_school_student_form_fees" model="ir.ui.view">
        <field name="name">school.student.form.fees</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="school_student.view_school_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Fees" name="fees">
                    <group>
                        <field name="fee_balance"/>
                    </group>
                    <field name="fee_assignment_ids">
                        <list>
                            <field name="reference"/>
                            <field name="academic_year_id"/>
                            <field name="structure_id"/>
                            <field name="total_amount"/>
                            <field name="paid_amount"/>
                            <field name="balance"/>
                            <field name="payment_state"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
