<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="rule_business_dashboard_owner_or_shared" model="ir.rule">
            <field name="name">Dashboard: business owner or shared groups</field>
            <field name="model_id" ref="school_dashboard.model_school_dashboard"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('sales_team.group_sale_manager')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_invoice')), (4, ref('account.group_account_manager'))]"/>
            <field name="domain_force">['|', ('user_id', '=', user.id), ('group_ids', 'in', user.all_group_ids.ids)]</field>
        </record>
        <record id="rule_business_dashboard_item_owner_or_shared" model="ir.rule">
            <field name="name">Dashboard item: business owner or shared groups</field>
            <field name="model_id" ref="school_dashboard.model_school_dashboard_item"/>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman')), (4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('sales_team.group_sale_manager')), (4, ref('account.group_account_readonly')), (4, ref('account.group_account_invoice')), (4, ref('account.group_account_manager'))]"/>
            <field name="domain_force">['|', ('dashboard_id.user_id', '=', user.id), ('dashboard_id.group_ids', 'in', user.all_group_ids.ids)]</field>
        </record>
    </data>
</odoo>
