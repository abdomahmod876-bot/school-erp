<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Sales -->
        <record id="dashboard_sales" model="school.dashboard">
            <field name="name">Sales Dashboard</field>
            <field name="description">Confirmed revenue, open quotations, salespeople and top customers.</field>
            <field name="sequence">30</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="group_ids" eval="[(6, 0, [ref('school_core.group_school_manager'), ref('school_core.group_school_user'), ref('sales_team.group_sale_salesman_all_leads'), ref('sales_team.group_sale_manager')])]"/>
        </record>

        <record id="item_sales_confirmed" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_sales"/>
            <field name="name">Confirmed Orders</field>
            <field name="item_type">tile</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="measure">count</field>
            <field name="domain">[('state', '=', 'sale')]</field>
            <field name="sequence">10</field>
            <field name="icon">fa-shopping-cart</field>
            <field name="color">#22c55e</field>
            <field name="span">3</field>
        </record>

        <record id="item_sales_quotations" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_sales"/>
            <field name="name">Open Quotations</field>
            <field name="item_type">tile</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="measure">count</field>
            <field name="domain">[('state', 'in', ['draft', 'sent'])]</field>
            <field name="sequence">20</field>
            <field name="icon">fa-file-text-o</field>
            <field name="color">#f59e0b</field>
            <field name="span">3</field>
        </record>

        <record id="item_sales_revenue" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_sales"/>
            <field name="name">Revenue (Untaxed)</field>
            <field name="item_type">kpi</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="sale.field_sale_order__amount_untaxed"/>
            <field name="date_field_id" ref="sale.field_sale_order__date_order"/>
            <field name="domain">[('state', '=', 'sale')]</field>
            <field name="sequence">30</field>
            <field name="icon">fa-line-chart</field>
            <field name="color">#6366f1</field>
            <field name="span">6</field>
        </record>

        <record id="item_sales_trend" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_sales"/>
            <field name="name">Revenue Trend (Monthly)</field>
            <field name="item_type">line</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="sale.field_sale_order__amount_untaxed"/>
            <field name="date_field_id" ref="sale.field_sale_order__date_order"/>
            <field name="domain">[('state', '=', 'sale')]</field>
            <field name="limit">12</field>
            <field name="sequence">40</field>
            <field name="icon">fa-line-chart</field>
            <field name="color">#6366f1</field>
            <field name="span">8</field>
        </record>

        <record id="item_sales_status" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_sales"/>
            <field name="name">Orders by Status</field>
            <field name="item_type">pie</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="measure">count</field>
            <field name="groupby_field_id" ref="sale.field_sale_order__state"/>
            <field name="sequence">50</field>
            <field name="icon">fa-pie-chart</field>
            <field name="color">#0ea5e9</field>
            <field name="span">4</field>
        </record>

        <record id="item_sales_salespersons" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_sales"/>
            <field name="name">Sales by Salesperson</field>
            <field name="item_type">bar</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="sale.field_sale_order__amount_untaxed"/>
            <field name="groupby_field_id" ref="sale.field_sale_order__user_id"/>
            <field name="domain">[('state', '=', 'sale')]</field>
            <field name="limit">8</field>
            <field name="sequence">60</field>
            <field name="icon">fa-users</field>
            <field name="color">#14b8a6</field>
            <field name="span">6</field>
        </record>

        <record id="item_sales_customers" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_sales"/>
            <field name="name">Top Customers</field>
            <field name="item_type">bar</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="sale.field_sale_order__amount_untaxed"/>
            <field name="groupby_field_id" ref="sale.field_sale_order__partner_id"/>
            <field name="domain">[('state', '=', 'sale')]</field>
            <field name="limit">8</field>
            <field name="sequence">70</field>
            <field name="icon">fa-building</field>
            <field name="color">#a855f7</field>
            <field name="span">6</field>
        </record>

        <record id="item_sales_latest" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_sales"/>
            <field name="name">Latest Orders</field>
            <field name="item_type">list</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="limit">8</field>
            <field name="list_field_ids" eval="[(6, 0, [ref('sale.field_sale_order__name'), ref('sale.field_sale_order__partner_id'), ref('sale.field_sale_order__amount_total'), ref('sale.field_sale_order__state')])]"/>
            <field name="sequence">80</field>
            <field name="icon">fa-list</field>
            <field name="color">#64748b</field>
            <field name="span">12</field>
        </record>

        <!-- Invoicing -->
        <record id="dashboard_invoicing" model="school.dashboard">
            <field name="name">Invoicing Dashboard</field>
            <field name="description">Invoiced revenue, receivables, invoice status and top customers.</field>
            <field name="sequence">40</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="group_ids" eval="[(6, 0, [ref('school_core.group_school_manager'), ref('school_core.group_school_user'), ref('account.group_account_invoice'), ref('account.group_account_manager')])]"/>
        </record>

        <record id="item_inv_revenue" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_invoicing"/>
            <field name="name">Invoiced Revenue</field>
            <field name="item_type">kpi</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_total"/>
            <field name="date_field_id" ref="account.field_account_move__invoice_date"/>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]</field>
            <field name="sequence">10</field>
            <field name="icon">fa-money</field>
            <field name="color">#0ea5e9</field>
            <field name="span">6</field>
        </record>

        <record id="item_inv_receivable" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_invoicing"/>
            <field name="name">Outstanding Receivable</field>
            <field name="item_type">tile</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_residual"/>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]</field>
            <field name="sequence">20</field>
            <field name="icon">fa-exclamation-circle</field>
            <field name="color">#ef4444</field>
            <field name="span">3</field>
        </record>

        <record id="item_inv_count" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_invoicing"/>
            <field name="name">Customer Invoices</field>
            <field name="item_type">tile</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="measure">count</field>
            <field name="domain">[('move_type', '=', 'out_invoice')]</field>
            <field name="sequence">30</field>
            <field name="icon">fa-file-text-o</field>
            <field name="color">#22c55e</field>
            <field name="span">3</field>
        </record>

        <record id="item_inv_trend" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_invoicing"/>
            <field name="name">Invoiced per Month</field>
            <field name="item_type">line</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_total"/>
            <field name="date_field_id" ref="account.field_account_move__invoice_date"/>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]</field>
            <field name="limit">12</field>
            <field name="sequence">40</field>
            <field name="icon">fa-line-chart</field>
            <field name="color">#6366f1</field>
            <field name="span">8</field>
        </record>

        <record id="item_inv_status" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_invoicing"/>
            <field name="name">Invoices by Status</field>
            <field name="item_type">pie</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="measure">count</field>
            <field name="groupby_field_id" ref="account.field_account_move__state"/>
            <field name="domain">[('move_type', '=', 'out_invoice')]</field>
            <field name="sequence">50</field>
            <field name="icon">fa-pie-chart</field>
            <field name="color">#f59e0b</field>
            <field name="span">4</field>
        </record>

        <record id="item_inv_customers" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_invoicing"/>
            <field name="name">Top Invoiced Customers</field>
            <field name="item_type">bar</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_total"/>
            <field name="groupby_field_id" ref="account.field_account_move__partner_id"/>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]</field>
            <field name="limit">8</field>
            <field name="sequence">60</field>
            <field name="icon">fa-building</field>
            <field name="color">#a855f7</field>
            <field name="span">6</field>
        </record>

        <record id="item_inv_receivables" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_invoicing"/>
            <field name="name">Receivables by Customer</field>
            <field name="item_type">bar</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="measure">sum</field>
            <field name="measure_field_id" ref="account.field_account_move__amount_residual"/>
            <field name="groupby_field_id" ref="account.field_account_move__partner_id"/>
            <field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]</field>
            <field name="limit">8</field>
            <field name="sequence">70</field>
            <field name="icon">fa-user-circle-o</field>
            <field name="color">#ef4444</field>
            <field name="span">6</field>
        </record>

        <record id="item_inv_latest" model="school.dashboard.item">
            <field name="dashboard_id" ref="dashboard_invoicing"/>
            <field name="name">Latest Invoices</field>
            <field name="item_type">list</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain">[('move_type', '=', 'out_invoice')]</field>
            <field name="limit">8</field>
            <field name="list_field_ids" eval="[(6, 0, [ref('account.field_account_move__name'), ref('account.field_account_move__partner_id'), ref('account.field_account_move__invoice_date'), ref('account.field_account_move__amount_total'), ref('account.field_account_move__state')])]"/>
            <field name="sequence">80</field>
            <field name="icon">fa-list</field>
            <field name="color">#64748b</field>
            <field name="span">12</field>
        </record>

    </data>
</odoo>
