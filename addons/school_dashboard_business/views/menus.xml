<odoo>
    <data>
        <record id="action_sales_dashboard" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">school_dashboard.dashboard_action</field>
            <field name="params" eval="{'dashboard_id': ref('dashboard_sales')}"/>
        </record>
        <record id="action_invoicing_dashboard" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">school_dashboard.dashboard_action</field>
            <field name="params" eval="{'dashboard_id': ref('dashboard_invoicing')}"/>
        </record>

        <menuitem id="menu_sales_dashboard"
                  name="Dashboard"
                  parent="sale.sale_menu_root"
                  action="action_sales_dashboard"
                  sequence="1"
                  groups="sales_team.group_sale_salesman"/>

        <menuitem id="menu_invoicing_dashboard"
                  name="Dashboard"
                  parent="account.menu_finance"
                  action="action_invoicing_dashboard"
                  sequence="1"
                  groups="account.group_account_invoice"/>
    </data>
</odoo>
