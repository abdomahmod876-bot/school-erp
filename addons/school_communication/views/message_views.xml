<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_communication_message_list" model="ir.ui.view">
        <field name="name">school.communication.message.list</field>
        <field name="model">school.communication.message</field>
        <field name="arch" type="xml">
            <list string="Communication Messages" sample="1">
                <field name="reference"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="channel"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'sent'"
                       decoration-danger="state == 'failed'"/>
                <field name="sent_date" optional="show"/>
                <field name="announcement_id" optional="hide"/>
                <field name="school_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_school_communication_message_form" model="ir.ui.view">
        <field name="name">school.communication.message.form</field>
        <field name="model">school.communication.message</field>
        <field name="arch" type="xml">
            <form string="Communication Message">
                <header>
                    <button name="action_send" type="object" string="Send"
                            class="btn-primary" invisible="state == 'sent'"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft" invisible="state != 'failed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="reference" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="announcement_id"/>
                            <field name="partner_id"
                                   options="{'no_create': True}"/>
                            <field name="school_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="channel"/>
                            <field name="sent_date"/>
                            <field name="error_message"/>
                        </group>
                    </group>
                    <group>
                        <field name="subject" placeholder="Message subject..."/>
                    </group>
                    <group>
                        <field name="body" placeholder="Message body..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_communication_message_search" model="ir.ui.view">
        <field name="name">school.communication.message.search</field>
        <field name="model">school.communication.message</field>
        <field name="arch" type="xml">
            <search string="Communication Messages">
                <field name="reference"/>
                <field name="subject"/>
                <field name="partner_id"/>
                <field name="announcement_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_sent" string="Sent"
                        domain="[('state', '=', 'sent')]"/>
                <filter name="filter_failed" string="Failed"
                        domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="filter_portal" string="Portal"
                        domain="[('channel', '=', 'portal')]"/>
                <filter name="filter_email" string="Email"
                        domain="[('channel', '=', 'email')]"/>
                <separator/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
                <filter name="group_channel" string="Channel"
                        context="{'group_by': 'channel'}"/>
                <filter name="group_announcement" string="Announcement"
                        context="{'group_by': 'announcement_id'}"/>
                <filter name="group_school" string="School"
                        context="{'group_by': 'school_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_communication_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">school.communication.message</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No messages yet</p>
            <p>Notify guardians from an announcement to create messages here.</p>
        </field>
    </record>
</odoo>
