<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_school_announcement_teacher" model="ir.rule">
            <field name="name">Announcement: teachers see assigned schools only</field>
            <field name="model_id" ref="model_school_announcement"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_teacher'))]"/>
            <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
        </record>
        <record id="rule_school_communication_message_teacher" model="ir.rule">
            <field name="name">Communication message: teachers see assigned schools only</field>
            <field name="model_id" ref="model_school_communication_message"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_teacher'))]"/>
            <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
        </record>
    </data>
</odoo>
