<odoo>
    <data>
        <record id="view_partner_form_school_guardian" model="ir.ui.view">
            <field name="name">res.partner.form.school.guardian</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group string="School Guardian">
                        <group>
                            <field name="is_school_guardian"/>
                            <field name="guardian_occupation"/>
                        </group>
                    </group>
                    <field name="student_guardian_ids" readonly="1">
                        <list>
                            <field name="student_id"/>
                            <field name="relation"/>
                            <field name="is_primary"/>
                        </list>
                    </field>
                </xpath>
            </field>
        </record>

        <record id="view_school_guardian_list" model="ir.ui.view">
            <field name="name">school.guardian.list</field>
            <field name="model">res.partner</field>
            <field name="arch" type="xml">
                <list string="Guardians">
                    <field name="name"/>
                    <field name="guardian_occupation"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="city"/>
                    <field name="is_school_guardian" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_school_guardian" model="ir.actions.act_window">
            <field name="name">Guardians</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_school_guardian_list"/>
            <field name="domain">[('is_school_guardian', '=', True)]</field>
            <field name="context">{'default_is_school_guardian': True}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No guardians yet</p>
                <p>Guardians are linked to students from the student form.</p>
            </field>
        </record>
    </data>
</odoo>
