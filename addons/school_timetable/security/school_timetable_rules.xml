<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_period_teacher_school" model="ir.rule">
        <field name="name">Period: teachers limited to assigned schools</field>
        <field name="model_id" ref="model_school_period"/>
        <field name="groups" eval="[(4, ref('school_core.group_school_teacher'))]"/>
        <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
    </record>

    <record id="rule_timetable_teacher_school" model="ir.rule">
        <field name="name">Timetable: teachers limited to assigned schools</field>
        <field name="model_id" ref="model_school_timetable"/>
        <field name="groups" eval="[(4, ref('school_core.group_school_teacher'))]"/>
        <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
    </record>

    <record id="rule_timetable_slot_teacher_school" model="ir.rule">
        <field name="name">Timetable slot: teachers limited to assigned schools</field>
        <field name="model_id" ref="model_school_timetable_slot"/>
        <field name="groups" eval="[(4, ref('school_core.group_school_teacher'))]"/>
        <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
    </record>
</odoo>
