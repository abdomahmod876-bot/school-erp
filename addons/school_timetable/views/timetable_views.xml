<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_timetable_list" model="ir.ui.view">
        <field name="name">school.timetable.list</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <list string="Timetables" sample="1">
                <field name="section_id"/>
                <field name="academic_year_id"/>
                <field name="school_id" optional="hide"/>
                <field name="slot_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_school_timetable_form" model="ir.ui.view">
        <field name="name">school.timetable.form</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <form string="Timetable">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="section_id" string="Section"/>
                        <h1><field name="section_id" options="{'no_create': True}"/></h1>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="school_id"/>
                        </group>
                    </div>
                    <group>
                        <group>
                            <field name="slot_count"/>
                        </group>
                        <group>
                            <field name="note" placeholder="Internal notes..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Schedule" name="schedule">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="day_of_week"/>
                                    <field name="period_id" options="{'no_create': True}"
                                           domain="[('school_id', '=', parent.school_id)]"/>
                                    <field name="subject_id" options="{'no_create': True}"
                                           domain="[('school_id', '=', parent.school_id)]"/>
                                    <field name="teacher_id" options="{'no_create': True}"
                                           domain="[('school_id', '=', parent.school_id)]"/>
                                    <field name="room"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_school_timetable_kanban" model="ir.ui.view">
        <field name="name">school.timetable.kanban</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" sample="1">
                <field name="section_id"/>
                <field name="academic_year_id"/>
                <field name="slot_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <strong><field name="section_id"/></strong>
                        <div class="text-muted"><field name="academic_year_id"/></div>
                        <div>
                            <field name="slot_count"/> slots
                        </div>
                        <field name="state" widget="label_selection" options="{'classes': {'draft': 'secondary', 'published': 'success'}}"/>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_school_timetable_search" model="ir.ui.view">
        <field name="name">school.timetable.search</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <search string="Timetables">
                <field name="section_id"/>
                <field name="academic_year_id"/>
                <field name="school_id"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_published" string="Published"
                        domain="[('state', '=', 'published')]"/>
                <group name="group_by">
                    <filter name="group_school" string="School" context="{'group_by': 'school_id'}"/>
                    <filter name="group_year" string="Academic Year" context="{'group_by': 'academic_year_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_school_timetable" model="ir.actions.act_window">
        <field name="name">Timetables</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_school_timetable_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build the first section timetable</p>
            <p>Add slots by day and period; teacher, room and section conflicts are blocked automatically.</p>
        </field>
    </record>

    <record id="view_school_section_form_timetable" model="ir.ui.view">
        <field name="name">school.section.form.timetable</field>
        <field name="model">school.section</field>
        <field name="inherit_id" ref="school_academic.view_school_section_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Timetables" name="timetables">
                    <field name="timetable_ids">
                        <list>
                            <field name="academic_year_id"/>
                            <field name="slot_count"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_school_teacher_form_timetable" model="ir.ui.view">
        <field name="name">school.teacher.form.timetable</field>
        <field name="model">school.teacher</field>
        <field name="inherit_id" ref="school_teacher.view_school_teacher_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Timetable" name="timetable">
                    <group>
                        <field name="weekly_hours"/>
                    </group>
                    <field name="timetable_slot_ids" readonly="1">
                        <list>
                            <field name="day_of_week"/>
                            <field name="period_id"/>
                            <field name="section_id"/>
                            <field name="subject_id"/>
                            <field name="room"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
