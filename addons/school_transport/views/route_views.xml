<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_transport_route_list" model="ir.ui.view">
        <field name="name">school.transport.route.list</field>
        <field name="model">school.transport.route</field>
        <field name="arch" type="xml">
            <list string="Transport Routes" sample="1" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="vehicle_id"/>
                <field name="school_id"/>
                <field name="stop_count" string="Stops"/>
                <field name="running_count" string="Students"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_school_transport_route_form" model="ir.ui.view">
        <field name="name">school.transport.route.form</field>
        <field name="model">school.transport.route</field>
        <field name="arch" type="xml">
            <form string="Transport Route">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nasr City Route"/></h1>
                        <group>
                            <field name="code" placeholder="e.g. NC-01"/>
                        </group>
                    </div>
                    <group>
                        <group string="Route">
                            <field name="school_id"/>
                            <field name="branch_id"/>
                            <field name="vehicle_id"/>
                        </group>
                        <group string="Statistics">
                            <field name="stop_count"/>
                            <field name="subscription_count"/>
                            <field name="running_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stops" name="stops">
                            <field name="stop_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="pickup_time" widget="float_time"/>
                                    <field name="dropoff_time" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Subscriptions" name="subscriptions">
                            <field name="subscription_ids" readonly="1">
                                <list>
                                    <field name="reference"/>
                                    <field name="student_id"/>
                                    <field name="stop_id"/>
                                    <field name="direction"/>
                                    <field name="date_start"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'running'"
                                           decoration-danger="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Route notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_transport_route_search" model="ir.ui.view">
        <field name="name">school.transport.route.search</field>
        <field name="model">school.transport.route</field>
        <field name="arch" type="xml">
            <search string="Transport Routes">
                <field name="name"/>
                <field name="code"/>
                <field name="vehicle_id"/>
                <field name="school_id"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_school" string="School"
                        context="{'group_by': 'school_id'}"/>
                <filter name="group_vehicle" string="Vehicle"
                        context="{'group_by': 'vehicle_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_transport_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">school.transport.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first transport route</p>
            <p>Add the stops, pickup and drop-off times, then assign students.</p>
        </field>
    </record>
</odoo>
