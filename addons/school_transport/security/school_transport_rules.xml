<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_school_transport_vehicle_teacher" model="ir.rule">
            <field name="name">Vehicle: teachers see assigned schools only</field>
            <field name="model_id" ref="model_school_transport_vehicle"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_teacher'))]"/>
            <field name="domain_force">[('school_id', 'in', user.school_ids.ids)]</field>
        </record>
        <record id="rule_school_transport_vehicle_accountant" model="ir.rule">
            <field name="name">Vehicle: accountants see assigned schools only</field>
