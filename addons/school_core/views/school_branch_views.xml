<odoo>
    <data>
        <record id="view_school_branch_list" model="ir.ui.view">
            <field name="name">school.branch.list</field>
            <field name="model">school.branch</field>
            <field name="arch" type="xml">
                <list string="Branches" decoration-muted="not active">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="school_id"/>
                    <field name="manager_id"/>
                    <field name="phone"/>
                    <field name="city"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_school_branch_form" model="ir.ui.view">
            <field name="name">school.branch.form</field>
            <field name="model">school.branch</field>
            <field name="arch" type="xml">
                <form string="Branch">
                    <sheet>
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <field name="active" invisible="1"/>
                        <div class="oe_title">
                            <label for="name" string="Branch Name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Main Campus"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="school_id" options="{'no_create': True}"/>
                                <field name="manager_id" options="{'no_create': True}"/>
                            </group>
                            <group string="Contact">
                                <field name="phone" widget="phone"/>
                                <field name="email" widget="email"/>
                                <field name="street"/>
                                <field name="city"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Notes" name="notes">
                                <field name="note"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_school_branch_search" model="ir.ui.view">
            <field name="name">school.branch.search</field>
            <field name="model">school.branch</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="school_id"/>
                    <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                    <group name="group_by">
                        <filter name="group_school" string="School" context="{'group_by': 'school_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_school_branch" model="ir.actions.act_window">
            <field name="name">Branches</field>
            <field name="res_model">school.branch</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Add a branch to a school</p>
            </field>
        </record>
    </data>
</odoo>
