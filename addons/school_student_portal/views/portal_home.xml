<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_school_student" name="School Student Portal Card"
              customize_show="True" inherit_id="portal.portal_my_home" priority="26">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_client_category" position="inside">
            <t groups="school_core.group_school_student">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">My Student</t>
                    <t t-set="text">Fees, attendance, results and timetable</t>
                    <t t-set="url" t-value="'/my/student'"/>
                    <t t-set="placeholder_count" t-value="'school_student_count'"/>
                </t>
            </t>
        </div>
    </template>
</odoo>
