<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_school_enrollment_student_portal" model="ir.rule">
            <field name="name">Enrollment: students see their own only</field>
            <field name="model_id" ref="school_admission.model_school_enrollment"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_school_attendance_session_student_portal" model="ir.rule">
            <field name="name">Attendance register: students see their own section registers</field>
            <field name="model_id" ref="school_attendance.model_school_attendance_session"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('section_id.enrollment_ids.student_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_school_attendance_line_student_portal" model="ir.rule">
            <field name="name">Attendance line: students see their own only</field>
            <field name="model_id" ref="school_attendance.model_school_attendance_line"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_school_exam_student_portal" model="ir.rule">
            <field name="name">Exam: students see published exams only</field>
            <field name="model_id" ref="school_exam.model_school_exam"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('state', '=', 'published')]</field>
        </record>
        <record id="rule_school_exam_result_student_portal" model="ir.rule">
            <field name="name">Exam result: students see their own only</field>
            <field name="model_id" ref="school_exam.model_school_exam_result"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_school_fee_assignment_student_portal" model="ir.rule">
            <field name="name">Fee plan: students see their own only</field>
            <field name="model_id" ref="school_fees.model_school_fee_assignment"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_school_fee_assignment_line_student_portal" model="ir.rule">
            <field name="name">Fee line: students see their own only</field>
            <field name="model_id" ref="school_fees.model_school_fee_assignment_line"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('assignment_id.student_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_school_timetable_student_portal" model="ir.rule">
            <field name="name">Timetable: students see their own section timetables</field>
            <field name="model_id" ref="school_timetable.model_school_timetable"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('state', '=', 'published'), ('section_id.enrollment_ids.student_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_school_timetable_slot_student_portal" model="ir.rule">
            <field name="name">Timetable slot: students see their own section slots</field>
            <field name="model_id" ref="school_timetable.model_school_timetable_slot"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('section_id.enrollment_ids.student_id.user_id', '=', user.id)]</field>
        </record>
        <record id="rule_school_announcement_student_portal" model="ir.rule">
            <field name="name">Announcement: students see published announcements only</field>
            <field name="model_id" ref="school_communication.model_school_announcement"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('state', '=', 'published')]</field>
        </record>
        <record id="rule_school_communication_message_student_portal" model="ir.rule">
            <field name="name">Communication message: students see their own messages only</field>
            <field name="model_id" ref="school_communication.model_school_communication_message"/>
            <field name="groups" eval="[(4, ref('school_core.group_school_student'))]"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        </record>
    </data>
</odoo>
