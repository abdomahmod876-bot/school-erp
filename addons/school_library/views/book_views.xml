<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_library_book_list" model="ir.ui.view">
        <field name="name">school.library.book.list</field>
        <field name="model">school.library.book</field>
        <field name="arch" type="xml">
            <list string="Library Books" sample="1" decoration-muted="not active">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn" optional="show"/>
                <field name="category"/>
                <field name="copies_total" string="Copies"/>
                <field name="copies_on_loan" string="On Loan"/>
                <field name="copies_available" string="Available"/>
                <field name="shelf" optional="hide"/>
                <field name="school_id" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_school_library_book_form" model="ir.ui.view">
        <field name="name">school.library.book.form</field>
        <field name="model">school.library.book</field>
        <field name="arch" type="xml">
            <form string="Library Book">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Book title"/></h1>
                    </div>
                    <group>
                        <group string="Catalogue">
                            <field name="isbn"/>
                            <field name="author"/>
                            <field name="publisher"/>
                            <field name="category"/>
                            <field name="edition"/>
                            <field name="publication_year"/>
                        </group>
                        <group string="Stock">
                            <field name="school_id"/>
                            <field name="branch_id"/>
                            <field name="shelf"/>
                            <field name="copies_total"/>
                            <field name="copies_on_loan"/>
                            <field name="copies_available"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Loans" name="loans">
                            <field name="loan_ids" readonly="1">
                                <list>
                                    <field name="reference"/>
                                    <field name="member_id"/>
                                    <field name="loan_date"/>
                                    <field name="due_date"/>
                                    <field name="return_date"/>
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'borrowed'"
                                           decoration-success="state == 'returned'"
                                           decoration-danger="state == 'lost'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_library_book_search" model="ir.ui.view">
        <field name="name">school.library.book.search</field>
        <field name="model">school.library.book</field>
        <field name="arch" type="xml">
            <search string="Library Books">
                <field name="name"/>
                <field name="author"/>
                <field name="isbn"/>
                <field name="school_id"/>
                <filter name="filter_available" string="Available"
                        domain="[('copies_total', '&gt;', 0)]"/>
                <filter name="filter_archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <separator/>
                <filter name="group_category" string="Category"
                        context="{'group_by': 'category'}"/>
                <filter name="group_school" string="School"
                        context="{'group_by': 'school_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_library_book" model="ir.actions.act_window">
        <field name="name">Library Books</field>
        <field name="res_model">school.library.book</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first library book</p>
            <p>Track the catalogue, copies and loans of the school library.</p>
        </field>
    </record>
</odoo>
