<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_school_library_member" model="ir.sequence">
            <field name="name">Library Member Card</field>
            <field name="code">school.library.member</field>
            <field name="prefix">LIB/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_school_library_loan" model="ir.sequence">
            <field name="name">Library Loan</field>
            <field name="code">school.library.loan</field>
            <field name="prefix">LOAN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
