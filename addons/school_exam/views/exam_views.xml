<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_exam_list" model="ir.ui.view">
        <field name="name">school.exam.list</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <list string="Exams" sample="1">
                <field name="name"/>
                <field name="exam_type" widget="badge"/>
                <field name="academic_year_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="schedule_count"/>
                <field name="average_percent"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="view_school_exam_form" model="ir.ui.view">
        <field name="name">school.exam.form</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <form string="Exam">
                <header>
                    <button name="action_generate_results" string="Generate Results"
                            type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_publish_results" string="Publish Results"
                            type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object" invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Midterm Exam 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="exam_type"/>
                            <field name="academic_year_id" options="{'no_create': True}"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="school_id" options="{'no_create': True}"/>
                            <field name="branch_id" options="{'no_create': True}"/>
                            <field name="schedule_count"/>
                            <field name="result_count"/>
                            <field name="average_percent"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sections" name="sections">
                            <field name="section_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </page>
                        <page string="Schedule" name="schedule">
                            <field name="schedule_ids">
                                <list editable="bottom">
                                    <field name="subject_id"
                                           domain="[('school_id', '=', parent.school_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="date"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="room"/>
                                    <field name="teacher_id"
                                           domain="[('school_id', '=', parent.school_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="max_marks"/>
                                    <field name="pass_mark"/>
                                    <field name="result_count"/>
                                    <field name="average_percent"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_school_exam_kanban" model="ir.ui.view">
        <field name="name">school.exam.kanban</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="name"/>
                <field name="exam_type"/>
                <field name="date_start"/>
                <field name="schedule_count"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <strong><field name="name"/></strong>
                            </div>
                            <div class="col-4 text-end">
                                <field name="state" widget="label_selection"
                                       options="{'classes': {'draft': 'secondary', 'published': 'success'}}"/>
                            </div>
                        </div>
                        <div class="text-muted">
                            <field name="exam_type"/> &#183; <field name="date_start"/>
                        </div>
                        <div class="text-muted">
                            <field name="schedule_count"/> subjects
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_school_exam_search" model="ir.ui.view">
        <field name="name">school.exam.search</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <search string="Exams">
                <field name="name"/>
                <field name="academic_year_id"/>
                <field name="section_ids"/>
                <filter name="filter_draft" string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_published" string="Results Published"
                        domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter name="group_year" string="Academic Year"
                        context="{'group_by': 'academic_year_id'}"/>
                <filter name="group_type" string="Type"
                        context="{'group_by': 'exam_type'}"/>
                <filter name="group_state" string="Status"
                        context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="action_school_exam" model="ir.actions.act_window">
        <field name="name">Exams</field>
        <field name="res_model">school.exam</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_school_exam_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first exam</p>
            <p>Define the exam period, select the sections, schedule the subjects and enter the results.</p>
        </field>
    </record>

    <record id="view_school_section_form_exam" model="ir.ui.view">
        <field name="name">school.section.form.exam</field>
        <field name="model">school.section</field>
        <field name="inherit_id" ref="school_academic.view_school_section_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Exams" name="exams">
                    <field name="exam_ids">
                        <list>
                            <field name="name"/>
                            <field name="exam_type"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_school_student_form_exam" model="ir.ui.view">
        <field name="name">school.student.form.exam</field>
        <field name="model">school.student</field>
        <field name="inherit_id" ref="school_student.view_school_student_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Exam Results" name="exam_results">
                    <field name="exam_result_ids">
                        <list>
                            <field name="exam_id"/>
                            <field name="subject_id"/>
                            <field name="date"/>
                            <field name="score"/>
                            <field name="max_marks"/>
                            <field name="percentage"/>
                            <field name="grade"/>
                            <field name="passed"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
